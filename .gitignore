# Ruwe bronnen: PDF's en EPUB's.
# Groot, en auteursrechtelijk niet iets om in een publieke repo te zetten.
sources/

# Werkdata (monsters van externe datasets).
# data/README.md beschrijft hoe je ze opnieuw ophaalt.
data/*
!data/README.md
*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors en OS
.DS_Store
Thumbs.db

# Tijdelijk
*.tmp
*.log

# Chat-transcript met werknotities: geen documentatie, niet publiceren.
Crypto_wash_trading_analysis.md

# Volledige tekstconversies van boeken en papers van derden: lokaal bewaard,
# niet in de repo. De rechten liggen bij de uitgevers, niet bij ons.
# De index docs/bronnen/README.md is eigen werk en blijft wel in de repo.
docs/bronnen/*.md
!docs/bronnen/README.md
